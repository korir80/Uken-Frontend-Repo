VITE_API_BASE_URL=http://localhost:8080/api
# Set to "false" once the Spring Boot backend is reachable.
VITE_USE_MOCK_API=true

# Cloudinary direct-browser uploads (unsigned preset). Frontend uploads images
# directly; the Spring Boot backend only stores the returned public URL string.
# Create an unsigned preset at Cloudinary → Settings → Upload.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
